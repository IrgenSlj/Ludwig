# Copy to .env and fill in. Keep .env out of version control.
LUDWIG_DOMAIN=ludwig.example-factory.nl
# A long random string: openssl rand -base64 32
POSTGRES_PASSWORD=
# Projects with no activity for this many days are deleted (empty: keep until deleted).
LUDWIG_RETENTION_DAYS=180
LUDWIG_MAX_UPLOAD_MB=200
# Backups: where on the server, how many days, at which hour (UTC).
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=2
